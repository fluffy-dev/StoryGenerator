# App Settings
APP_TITLE="AI Story Generator"
APP_VERSION="1.0.0"
DEBUG=True

# OpenAI Settings
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# CORS Settings
# Разрешенные источники через запятую
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS="*"
CORS_ALLOW_HEADERS="*"