# App Settings
APP_TITLE="AI Story Generator"
APP_VERSION="1.0.0"
DEBUG=True

# OpenAI Settings
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# CORS Settings
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

#Yii2 settings
PYTHON_API_URL=http://python-api:8000

#Postgres settings
POSTGRES_DB=yii2db
POSTGRES_USER=yii2user
POSTGRES_PASSWORD=yii2password